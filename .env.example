# Copie este arquivo para /apps/emoda-v1/.env no servidor e preencha os valores.
# O docker compose injeta estas variáveis no container do backend.

# App
AMBIENTE=PROD
PORT=4000
# Porta publicada no host (o Nginx faz proxy para ela).
# 4001 evita conflito com o e-moda novo, que ocupa a 4000.
HOST_PORT=4001
FRONTEND_URL=https://www.emodaapp.com.br

# Database (MySQL)
DB_HOST=172.31.0.6
DB_PORT=3306
DB_USER=root
DB_PASS=SUBSTITUIR
DB_NAME=emoda

# SSL do banco — só preencha se o MySQL exigir (ex.: RDS).
# O global-bundle.pem da raiz do projeto é copiado para /app/certs/ na imagem.
DB_SSL=false
DB_SSL_CA=/app/certs/global-bundle.pem

# Security — gere com: openssl rand -hex 64
JWT_SECRET=SUBSTITUIR
